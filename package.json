{
  "name": "rifa-gata-amelia",
  "version": "1.0.0",
  "private": true,
  "description": "Rifa Solidária da Amélia — plataforma de rifa beneficente (Cloudflare Pages + Functions + D1)",
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB --compatibility-date=2024-11-01",
    "db:init:local": "wrangler d1 execute rifa-amelia --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute rifa-amelia --local --file=./seed.sql",
    "db:init:remote": "wrangler d1 execute rifa-amelia --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute rifa-amelia --remote --file=./seed.sql",
    "deploy": "wrangler pages deploy public"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
